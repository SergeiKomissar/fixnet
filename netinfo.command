#!/bin/bash
# Кнопка: открывает Терминал и запускает netinfo.sh через sudo (ради точного
# определения скрытой сети и силы сигнала — они доступны только под root).
# Меню (t — детали, a — советы, r — обновить, Enter — закрыть) теперь ВНУТРИ
# скрипта: он один раз собирает данные и сам держит окно. Ничего не меняет.
clear
echo "=== NETINFO — осмотр сети ==="
echo
sudo "$HOME/bin/netinfo.sh"
